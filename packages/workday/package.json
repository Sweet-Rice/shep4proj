{
  "name": "@jevschedule/workday",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src scripts && prettier --check src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src scripts",
    "smoke:launch": "tsc -b && node scripts/smoke-launch.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  }
}
