{
  "name": "@jevschedule/workday",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./academic-record": {
      "types": "./dist/academic-record/index.d.ts",
      "default": "./dist/academic-record/index.js"
    },
    "./current-registrations": {
      "types": "./dist/current-registrations/index.d.ts",
      "default": "./dist/current-registrations/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src scripts && prettier --check src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src scripts",
    "smoke:launch": "tsc -b && node scripts/smoke-launch.ts",
    "smoke:login": "tsc -b && node scripts/smoke-login.ts",
    "redact:har": "node scripts/redact-har.ts",
    "capture": "tsc -b && node scripts/capture-workday.ts",
    "verify:record": "node scripts/verify-record.ts",
    "inspect:grids": "node scripts/inspect-grids.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "playwright-core": "^1.63.0",
    "zod": "^3.24.1"
  }
}
