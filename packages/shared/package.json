{
  "name": "@jevschedule/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src scripts && prettier --check src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src scripts",
    "coverage:prereqs": "node scripts/prereq-coverage.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
