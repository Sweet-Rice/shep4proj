# Copy to .env to override the defaults in docker-compose.yml. .env is git-ignored.
# These are local development values only; never put production credentials here.

POSTGRES_USER=jevschedule
POSTGRES_PASSWORD=jevschedule
POSTGRES_DB=jevschedule
# Host port for Postgres. Change it if something else already uses 5432.
POSTGRES_PORT=5432

# Connection string for the server (read by Drizzle from T-016 on).
# Keep it in sync with the values above.
DATABASE_URL=postgres://jevschedule:jevschedule@localhost:5432/jevschedule

# Path to degree requirement YAML files (defaults to data/degrees).
# DEGREE_DATA_DIR=
# Daily scrape of section listings from the public Course Offerings portal (T-403).
# Off by default so a dev server never hits the live site; the server checks hourly and
# reads each term at most once a day. Departments are comma-separated course prefixes.
SECTION_SCRAPE_ENABLED=false
SECTION_SCRAPE_DEPARTMENTS=CSC
# Seat alerts (T-512): polls only sections someone is watching for newly opened seats. Off by
# default so a dev server never hits the live site. LSU refreshes seats daily, so the interval
# defaults to 1440 minutes (24 h); it may not be under 60. Failed polls retry sooner, backing off.
SEAT_POLL_ENABLED=false
SEAT_POLL_INTERVAL_MINUTES=1440
