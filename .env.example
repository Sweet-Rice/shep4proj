# Copy to .env to override the defaults in docker-compose.yml. .env is git-ignored.
# These are local development values only; never put production credentials here.

POSTGRES_USER=jevschedule
POSTGRES_PASSWORD=jevschedule
POSTGRES_DB=jevschedule
# Host port for Postgres. Change it if something else already uses 5432.
POSTGRES_PORT=5432

# Connection string for the server (read by Drizzle from T-016 on).
# Keep it in sync with the values above.
DATABASE_URL=postgres://jevschedule:jevschedule@localhost:5432/jevschedule
