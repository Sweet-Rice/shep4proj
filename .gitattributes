# Keep LF everywhere so Prettier/ESLint pass on Windows checkouts.
* text=auto eol=lf

*.png binary
*.jpg binary
*.pdf binary
*.har binary

# Saved catalog HTML is a verbatim capture of what LSU served (some pages contain
# CRLF). Store it byte-for-byte so the checksums in its README stay valid.
fixtures/catalog/**/*.html -text
