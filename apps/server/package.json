{
  "name": "@jevschedule/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src && prettier --check src",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:fixtures": "tsc -b && node dist/scripts/seed-fixtures.js",
    "db:scrape:catalog": "tsc -b && node dist/scripts/scrape-catalog.js",
    "db:scrape:sections": "tsc -b && node dist/scripts/scrape-sections.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@jevschedule/scraper": "workspace:*",
    "@jevschedule/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
