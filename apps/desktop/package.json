{
  "name": "@jevschedule/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "postinstall": "install-electron --no",
    "build": "tsc -b && electron-vite build",
    "dev": "electron-vite dev",
    "lint": "eslint src && prettier --check src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@jevschedule/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^2.1.8"
  }
}
